---
import { links, type SiteContent } from '../content/site';

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
---

<section class="section contact" id="contact">
  <div class="container reveal">
    <h2 class="section-title">{content.contact.title}</h2>
    <p class="contact-lead">{content.contact.lead}</p>
    <p class="contact-location">{content.contact.location}</p>
    <ul class="contact-links">
      <li>
        <span class="label">{content.contact.emailLabel}</span>
        <a href={`mailto:${links.email}`}>{links.email}</a>
      </li>
      <li>
        <span class="label">{content.contact.linkedinLabel}</span>
        <a href={links.linkedin} target="_blank" rel="noopener noreferrer">linkedin.com/in/kazusa-tsubota</a>
      </li>
      <li>
        <span class="label">{content.contact.githubLabel}</span>
        <a href={links.github} target="_blank" rel="noopener noreferrer">github.com/tsubokazu</a>
      </li>
    </ul>
  </div>
</section>

<style>
  .contact-lead {
    max-width: 34rem;
    color: var(--color-ink-muted);
    font-size: 1.08rem;
    margin-bottom: 0.65rem;
  }

  .contact-location {
    font-weight: 600;
    color: var(--color-accent-soft);
    margin-bottom: 1.75rem;
  }

  .contact-links {
    display: grid;
    gap: 1rem;
  }

  .contact-links li {
    display: grid;
    gap: 0.2rem;
  }

  .label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .contact-links a {
    font-size: 1.1rem;
    font-weight: 500;
    text-decoration-thickness: 1px;
  }

  @media (min-width: 700px) {
    .contact-links li {
      grid-template-columns: 7rem 1fr;
      align-items: baseline;
      gap: 1rem;
    }
  }
</style>
