---
import type { Locale, SiteContent } from '../content/site';
import LangSwitch from './LangSwitch.astro';

type Props = {
  locale: Locale;
  content: SiteContent;
};

const { locale, content } = Astro.props;
const home = locale === 'ja' ? '/ja/' : '/';
const items = [
  { href: `${home}#about`, label: content.nav.about },
  { href: `${home}#experience`, label: content.nav.experience },
  { href: `${home}#skills`, label: content.nav.skills },
  { href: `${home}#education`, label: content.nav.education },
  { href: `${home}#contact`, label: content.nav.contact },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={home}>{content.hero.name}</a>
    <nav class="nav" aria-label="Primary">
      <ul class="nav-list">
        {
          items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
      <LangSwitch locale={locale} />
    </nav>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">
      <span></span>
      <span></span>
    </button>
  </div>
  <div class="mobile-nav container" id="mobile-nav" hidden>
    <ul>
      {
        items.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
    <LangSwitch locale={locale} />
  </div>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const panel = document.getElementById('mobile-nav');
  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        panel.hidden = true;
      });
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    backdrop-filter: blur(12px);
    background: rgba(242, 239, 232, 0.82);
    border-bottom: 1px solid var(--color-line);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .brand:hover {
    color: var(--color-accent);
  }

  .nav {
    display: none;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-list {
    display: flex;
    gap: 1.35rem;
  }

  .nav-list a {
    position: relative;
    color: var(--color-ink-muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .nav-list a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.2rem;
    width: 100%;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }

  .nav-list a:hover {
    color: var(--color-ink);
  }

  .nav-list a:hover::after {
    transform: scaleX(1);
  }

  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 0.5rem;
  }

  .menu-toggle span {
    display: block;
    height: 1.5px;
    width: 100%;
    background: var(--color-ink);
    transition: transform 0.25s var(--ease-out);
  }

  .menu-toggle[aria-expanded='true'] span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .mobile-nav {
    display: grid;
    gap: 1.25rem;
    padding-block: 1rem 1.25rem;
    background: rgba(242, 239, 232, 0.96);
    border-bottom: 1px solid var(--color-line);
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav ul {
    display: grid;
    gap: 0.85rem;
  }

  .mobile-nav a {
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 500;
  }

  @media (min-width: 880px) {
    .nav {
      display: flex;
    }

    .menu-toggle,
    .mobile-nav {
      display: none !important;
    }
  }
</style>
